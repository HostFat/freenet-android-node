<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/site_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/site_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/refresh_site"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="↻"
            android:textSize="20sp" />

        <Button
            android:id="@+id/site_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/add_this_site"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="★"
            android:textSize="18sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/site_menu"
            style="?android:attr/buttonStyleSmall"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/more_actions"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="⋮"
            android:textSize="20sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/site_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textColor="#B3261E"
        android:textSize="12sp"
        android:visibility="gone" />

    <WebView
        android:id="@+id/site_webview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
